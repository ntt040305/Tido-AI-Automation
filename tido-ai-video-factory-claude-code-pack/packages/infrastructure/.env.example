# ============================================================================
# INFRASTRUCTURE ENVIRONMENT
#
# Credentials for the services behind @tido/infrastructure. Read only by this
# package, on the server. Nothing here is ever NEXT_PUBLIC_ except where it
# says so, and nothing here belongs in a browser bundle.
#
# Every variable is OPTIONAL. Absent credentials mean "nobody is signed in"
# and "nothing is recorded" -- both of which the application handles, because
# it rendered pictures for its whole life before this package existed. A
# missing key must never be able to fail a render.
# ============================================================================

# ── Firebase Authentication — identity, and nothing else ────────────────────
# Either the whole service account as one line of JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three-variable split, which is how most deployments carry it.
# The private key holds literal \n escapes; they are expanded before use.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Supabase — the database, and everything that is not identity ────────────
SUPABASE_URL=

# THE SERVICE ROLE KEY BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Server-side only. supabase/client.ts throws on import in a browser so that
# mistake is loud rather than silent.
SUPABASE_SERVICE_ROLE_KEY=

# ── Row Level Security — the second line of defence ─────────────────────────
# The publishable key is sent as `apikey` on user-scoped requests. It is safe
# to hold and grants nothing on its own: the `anon` role does NOT bypass RLS,
# so this key alone reads no rows. New projects issue sb_publishable_…; older
# ones issue a JWT-shaped anon key. Either name works.
#
# Without it there is no user-scoped client, every request reaches Postgres as
# service_role, and the policies in migration 0002 are never exercised --
# leaving the repository layer as the only thing enforcing tenancy.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=          # accepted as an alias

# ── Migrations and verification (not needed at runtime) ─────────────────────
# Project Settings -> Database -> Connection string -> URI.
# Used by scripts/migrate.mjs, verify-schema.mjs and verify-rls.mjs only. The
# application never opens a direct Postgres connection.
SUPABASE_DB_URL=

# ── Supabase Storage ────────────────────────────────────────────────────────
# Bucket for files the application stores. Not used by the image engine, which
# writes its own render folders to disk and must not import this package.
SUPABASE_STORAGE_BUCKET=tido-assets

# ============================================================================
# DO NOT SET
#
# SUPABASE_JWT_SECRET
#   Nothing reads this. If you were handed a value for it from the Supabase
#   dashboard's legacy API keys section, check what it actually is before
#   storing it: in this project it was the legacy service_role JWT -- a second
#   full-privilege credential under a name that sounds like a low-privilege
#   one. A key that grants more than its name suggests is how a secret ends up
#   somewhere it should not be.
#
#   The genuine HS256 signing secret would only be needed to mint Supabase
#   tokens server-side, which this integration deliberately does not do: the
#   third-party auth path lets Supabase validate Firebase tokens itself, with
#   no second signing key to hold or rotate.
# ============================================================================
