{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@tido/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
