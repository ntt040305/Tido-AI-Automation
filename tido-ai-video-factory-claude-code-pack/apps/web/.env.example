# ============================================================================
# APPLICATION ENVIRONMENT
#
# Configuration for the web application and the AI pipeline. Infrastructure
# credentials are NOT here -- Firebase and Supabase keys live in
# packages/infrastructure/.env.example, because they are read only by that
# package and keeping them apart is what stops a route reaching for one
# directly.
# ============================================================================

# ── AI gateway ──────────────────────────────────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── Prompt budget ───────────────────────────────────────────────────────────
# The compiler's hard ceiling. Raised above the source default for providers
# that accept longer prompts.
PROMPT_HARD_MAXIMUM_CHARS=32000

# ── Pipeline data paths ─────────────────────────────────────────────────────
# Overridable so a test run can never touch real flags or logs.
TIDO_FLAGS_PATH=
TIDO_EVOLUTION_LOG_PATH=
TIDO_KITS_PATH=
